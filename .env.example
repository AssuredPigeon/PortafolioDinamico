# Copia este archivo como .env y configura tus variables locales.
# NUNCA subas el archivo .env al repositorio Git (Regla 5).

# 1. Conexión a PostgreSQL (local, Supabase gratis o Neon gratis)
# Ejemplo PostgreSQL local:
# DATABASE_URL=postgresql+psycopg://postgres:tu_password@localhost:5432/portafolio_db
# Ejemplo Supabase / Neon (con SSL):
# DATABASE_URL=postgresql+psycopg://usuario:password@host.supabase.com:5432/postgres?sslmode=require
# (Si se deja vacío durante pruebas locales rápidas, usa automáticamente SQL local en data/portfolio_local.db)
DATABASE_URL=

# 2. Token personal de GitHub (opcional para repos públicos; sube el límite de 60 a 5,000 peticiones/hora)
# Usa un Fine-grained Personal Access Token de solo lectura pública (sin permisos de escritura).
GITHUB_TOKEN=
